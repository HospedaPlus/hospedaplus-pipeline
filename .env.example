# --- Airflow ---
# Your Linux user id (`id -u`). On Ubuntu EC2 it is 1000; Airflow must be able to write logs/ and config/.
AIRFLOW_UID=1000
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
AIRFLOW_JWT_SECRET=change-me-hospedaplus
RABBITMQ_USER=hospedaplus
RABBITMQ_PASSWORD=hospedaplus

# --- Neon (read only, role etl_reader) ---
NEON_READ_URL=postgresql://etl_reader:***@ep-xxx.us-east-2.aws.neon.tech/hospedaplus?sslmode=require
# --- Neon (write, role app_writer): only gold_neon_writeback uses it (workers EC2) ---
NEON_WRITE_URL=postgresql://app_writer:***@ep-xxx.us-east-2.aws.neon.tech/hospedaplus?sslmode=require
# true = after the upsert, call operation.refresh_overbooking_limits() (changes how many rooms can be sold)
NEON_REFRESH_OVERBOOKING=false

# --- S3 lakehouse ---
S3_BUCKET=hospedaplus-lakehouse
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-2
# Optional: S3-compatible endpoint (e.g. MinIO) for local tests
S3_ENDPOINT_URL=

# --- Deploy on 2 EC2 (docker-compose.nucleo.yaml + docker-compose.workers.yaml) ---
# Private IP of the EC2 núcleo (only needed on the workers EC2)
NUCLEO_HOST=
# Password of the Airflow metadata DB (same value on both EC2)
POSTGRES_PASSWORD=airflow
# Task logs in S3 so the UI can read logs from the workers EC2
REMOTE_LOGGING=true

# --- Sources read by the bronze DAGs ---
# F5 reviews API base URL (the DAG adds /api/v1/reviews)
F5_API_URL=https://api-reviews-buenavista.coderhivex.com
F5_API_KEY=
# F6a holidays API v4 (GET {base}/api/v4/Holidays/{country}/{year})
NAGER_BASE_URL=https://nagerholidays.com
