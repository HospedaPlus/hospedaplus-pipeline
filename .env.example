# --- Airflow ---
AIRFLOW_UID=50000
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
AIRFLOW_JWT_SECRET=change-me-hospedaplus
RABBITMQ_USER=hospedaplus
RABBITMQ_PASSWORD=hospedaplus

# --- Neon (read only, role etl_reader) ---
NEON_READ_URL=postgresql://etl_reader:***@ep-xxx.us-east-2.aws.neon.tech/hospedaplus?sslmode=require

# --- S3 lakehouse ---
S3_BUCKET=hospedaplus-lakehouse
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-2
# Optional: S3-compatible endpoint (e.g. MinIO) for local tests
S3_ENDPOINT_URL=

# --- Deploy on 2 EC2 (docker-compose.nucleo.yaml + docker-compose.workers.yaml) ---
# Private IP of the EC2 núcleo (only needed on the workers EC2)
NUCLEO_HOST=
# Password of the Airflow metadata DB (same value on both EC2)
POSTGRES_PASSWORD=airflow
# Task logs in S3 so the UI can read logs from the workers EC2
REMOTE_LOGGING=true
